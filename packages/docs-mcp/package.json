{
  "name": "@acta-team/docs-mcp",
  "version": "0.1.3",
  "description": "MCP server for ACTA documentation.",
  "mcpName": "io.github.ACTA-Team/docs-mcp",
  "license": "MIT",
  "homepage": "https://docs.acta.build",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ACTA-Team/ACTA-docs.git",
    "directory": "packages/docs-mcp"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "acta",
    "verifiable-credentials",
    "stellar",
    "documentation"
  ],
  "type": "module",
  "bin": {
    "acta-docs-mcp": "dist/server.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "generate-docs": "tsx scripts/generate-docs.ts",
    "mcp": "node dist/server.js",
    "build": "npm run generate-docs && tsc -p tsconfig.json",
    "test": "npm run build && node scripts/smoke-test.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build",
    "pack:local": "npm pack",
    "publish:public": "npm publish --access public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18"
  }
}
